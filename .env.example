# Medical AI System - Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME="Medical AI System"
APP_VERSION="0.1.0"
DEBUG=true
ENVIRONMENT=development

# Google ADK / Gemini
# Get your API key from https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_MODEL=gemini-1.5-pro
GOOGLE_MODEL_TEMPERATURE=0.3
GOOGLE_MODEL_TOP_P=0.9
GOOGLE_MODEL_MAX_TOKENS=8192

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/medical_ai.db
DATABASE_ECHO=false

# ADK Sessions
ADK_SESSION_DB_URL=sqlite+aiosqlite:///./data/adk_sessions.db

# RAG / Vector Store
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_FAISS_INDEX_PATH=./data/faiss_index
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.7

# Medical Corpus
MEDICAL_CORPUS_PATH=./data/medical_corpus

# MCP Servers (if running separately)
MCP_DRUG_SERVER_URL=http://localhost:8001
MCP_PATIENT_SERVER_URL=http://localhost:8002
MCP_GUIDELINE_SERVER_URL=http://localhost:8003

# OpenFDA API (optional, for drug data)
OPENFDA_API_KEY=
OPENFDA_BASE_URL=https://api.fda.gov

# Security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# PHI Masking
PHI_MASKING_ENABLED=true
PHI_PRESIDIO_LANGUAGE=en

# Audit Logging
AUDIT_LOG_ENABLED=true
AUDIT_LOG_PATH=./logs/audit.log
AUDIT_LOG_MAX_SIZE_MB=100
AUDIT_LOG_BACKUP_COUNT=5

# Prompt Injection Detection
PROMPT_GUARD_ENABLED=true
PROMPT_GUARD_THRESHOLD=0.8

# Streamlit
STREAMLIT_HOST=0.0.0.0
STREAMLIT_PORT=8501
STREAMLIT_THEME_BASE=light
STREAMLIT_SERVER_HEADLESS=true

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_CORS_ORIGINS=["*"]

# ML Models
ML_MODEL_PATH=./models
ML_HEART_DISEASE_MODEL=heart_disease_xgb.pkl
ML_DIABETES_MODEL=diabetes_xgb.pkl
ML_RISK_MODEL=risk_xgb.pkl

# Simulation
SIMULATION_MONTHS=[3, 6, 12]
SIMULATION_MONTE_CARLO_RUNS=100

# Debate System
DEBATE_MAX_ROUNDS=3
DEBATE_CONFIDENCE_THRESHOLD=0.7
DEBATE_MIN_CONSENSUS=0.6

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=./logs/app.log

# External APIs (optional)
PUBMED_API_KEY=
CLINICAL_TRIALS_API_KEY=